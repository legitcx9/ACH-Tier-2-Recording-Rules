function Test-IsAdmin {
    ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()
    ).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

if (-not (Test-IsAdmin)) {
    Write-Host "`nThis needs to run as Administrator." -ForegroundColor Red
    Write-Host "Right-click PowerShell -> Run as Administrator, then re-run this script.`n" -ForegroundColor Yellow
    Pause
    exit 1
}

# Defender's WMI cmdlets only exist in the 64-bit namespace. If we're somehow
# running 32-bit PowerShell on a 64-bit OS, hop over to Sysnative so those
# checks don't all fail with "Invalid class".
$is64BitOS = [Environment]::Is64BitOperatingSystem
$is64BitProcess = [Environment]::Is64BitProcess

if ($is64BitOS -and -not $is64BitProcess) {
    $sysnativePwsh = Join-Path $env:WINDIR "Sysnative\WindowsPowerShell\v1.0\powershell.exe"
    if (Test-Path $sysnativePwsh) {
        Write-Host "Relaunching under 64-bit PowerShell..." -ForegroundColor Yellow
        $argList = @("-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "`"$PSCommandPath`"")
        $relaunch = Start-Process -FilePath $sysnativePwsh -ArgumentList $argList -PassThru -Wait
        exit $relaunch.ExitCode
    } else {
        Write-Host "Couldn't find 64-bit PowerShell to relaunch into -- Defender checks may fail." -ForegroundColor Yellow
    }
}

