# match. Starts the moment Step 6 finishes, runs on a timer in the background, and
# ends the instant the player presses Enter. Every finding is timestamped to
# match_monitor_log.txt, which is folded into the same evidence zip the rest of this
# script already produces below. This phase only detects and logs -- it never kills,
# blocks, or modifies anything, same as every other check in this script.
#
# Coverage note (read this before relying on it): this can reliably flag (a) known
# cheat binaries by hash, (b) the on-disk extraction artifacts that PyInstaller-based
# Python cheats leave in %TEMP% while running, (c) known public executor/cheat
# process names and window titles, (d) unsigned or oddly-located DLLs loaded into
# the Roblox process itself, and (e) any external process holding an open handle
# directly to Roblox's process object (the pattern used by executors that attach
# externally instead of injecting). Between (d) and (e) that covers both mechanisms
# public Roblox executors currently use to reach into the game.
# What this still CANNOT do: catch a cheat with an unknown hash, a generic/renamed
# process name, that neither injects a module nor opens a readable/writable handle
# to Roblox at the moment it's polled (e.g. it only touches memory in a narrow burst
# between poll cycles), or one specifically built to evade this exact script rather
# than executors in general. That last category is a genuine arms race no
# detection-and-log script wins outright -- pairing this with human review of the
# recording and the forensic evidence zip is still the point. Lower $pollIntervalSeconds
# below if you want tighter timing coverage at the cost of more CPU/log volume.
#
# UPDATE (v1.01): two of the checks below -- Test-KnownCheatHashes and the new
# Test-CheatFileStringSignatures -- are a deliberate, narrow exception to the
# "detect and log only" rule above. See the POLICY NOTE directly above
# Invoke-CheatTermination for why, and what is/isn't in scope for it.
# =====================================================================================

$timestamp = Get-Date -Format "yyyy-MM-dd_HH-mm-ss"
$outputRoot = Join-Path $env:USERPROFILE "Desktop\ACH"
$outputName = "OUTPUT-$timestamp"
$outputPath = Join-Path $outputRoot $outputName
$zipPath = "$outputPath.zip"

New-Item -ItemType Directory -Path $outputPath -Force | Out-Null

$monitorLogPath = Join-Path $outputPath "match_monitor_log.txt"
"** ACH live match monitor started $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" | Out-File -LiteralPath $monitorLogPath -Encoding utf8

function Write-MonitorLog {
    param([Parameter(Mandatory = $true)][string]$Line, [ConsoleColor]$Color = 'White')
    $stamped = "[{0}] {1}" -f (Get-Date -Format "HH:mm:ss"), $Line
    Add-Content -LiteralPath $monitorLogPath -Value $stamped
    Write-Host $stamped -ForegroundColor $Color
}

# --- Background CPU usage log ------------------------------------------------------
# Separate from match_monitor_log.txt on purpose: this isn't a cheat signal by
# itself (plenty of legit background software ticks over 0.1% CPU), it's raw
# evidence for a human reviewer -- "what else was running and using CPU while the
# match was being recorded" -- folded into the same evidence zip below.
$cpuLogPath = Join-Path $outputPath "background_cpu_usage.txt"
"** ACH background CPU usage monitor started $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') (threshold: >0.1% of total system CPU)" | Out-File -LiteralPath $cpuLogPath -Encoding utf8
$LogicalCoreCount = [Environment]::ProcessorCount

function Write-CpuLog {
    param([Parameter(Mandatory = $true)][string]$Line)
    Add-Content -LiteralPath $cpuLogPath -Value $Line
}

# Uses the PerfProc formatted counter (already normalized against the sampling
# interval by the OS) rather than diffing Process.TotalProcessorTime by hand --
# fewer ways for a poll tick that runs slightly long/short to skew the numbers.
# PercentProcessorTime here is relative to a single core, so it's divided by the
# logical core count to get a percentage of total system CPU.
function Test-BackgroundCpuUsage {
    try {
        $counters = Get-CimInstance Win32_PerfFormattedData_PerfProc_Process -ErrorAction Stop |
            Where-Object { $_.Name -and $_.Name -ne "_Total" -and $_.Name -ne "Idle" }
    } catch {
        Write-CpuLog "[{0}] %% CPU counter query failed: $($_.Exception.Message)" -f (Get-Date -Format "HH:mm:ss")
        return
    }

    foreach ($counter in $counters) {
        $percentOfSystem = [math]::Round(($counter.PercentProcessorTime / $LogicalCoreCount), 2)
        if ($percentOfSystem -le 0.1) { continue }

        $procId = $counter.IDProcess
        $procPath = "(path unavailable -- process may have exited or is protected)"
        try {
            $proc = Get-Process -Id $procId -ErrorAction Stop
            if ($proc.Path) { $procPath = $proc.Path }
        } catch {
            try {
                $cimMatch = Get-CimInstance Win32_Process -Filter "ProcessId = $procId" -ErrorAction Stop
                if ($cimMatch -and $cimMatch.ExecutablePath) { $procPath = $cimMatch.ExecutablePath }
            } catch {}
        }

        $stamped = "[{0}] {1} (PID {2}) CPU={3}% path='{4}'" -f (Get-Date -Format "HH:mm:ss"), $counter.Name, $procId, $percentOfSystem, $procPath
        Write-CpuLog $stamped
    }
}

