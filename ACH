    foreach ($path in $bamPaths) {
        if (-not (Test-Path $path)) { continue }
        $results.Add("registry path: $path")
        try {
            Get-ChildItem -Path $path -Recurse -ErrorAction Stop | ForEach-Object {
                $results.Add("path: $($_.Name)")
                try {
                    $properties = Get-ItemProperty $_.PsPath
                    foreach ($property in $properties.PSObject.Properties) {
                        if ($property.Name -notmatch "^PS") { $results.Add("$($property.Name): $($property.Value)") }
                    }
                } catch {}
            }
        } catch {
            $results.Add("bam collection failed: $($_.Exception.Message)")
        }
    }

    if ($results.Count -eq 0) { $results.Add("bam unavailable") }
    $results | Out-File -LiteralPath $output -Encoding utf8
}

function Collect-Amcache {
    $output = Join-Path $outputPath "amcache_summary.txt"
    $amcachePath = "C:\Windows\AppCompat\Programs\Amcache.hve"
    if (-not (Test-Path $amcachePath)) { "amcache unavailable" | Out-File $output; return }

    $parser = Get-ForensicTool -Name "AmcacheParser" -ZipUrl "https://download.ericzimmermanstools.com/AmcacheParser.zip" -ExeFilter "AmcacheParser.exe"
    if (-not $parser) { "amcacheparser unavailable" | Out-File $output; return }

    try {
        $amcacheScratch = Join-Path $PersistentToolsRoot "AmcacheParser\_scratch"
        New-Item -ItemType Directory -Path $amcacheScratch -Force -ErrorAction SilentlyContinue | Out-Null

        & $parser.FullName -f $amcachePath --csv $amcacheScratch | Out-Null

        $csv = Get-ChildItem -Path $amcacheScratch -Filter "*.csv" -ErrorAction SilentlyContinue |
            Sort-Object LastWriteTime | Select-Object -Last 1

        if ($csv) {
            Get-Content $csv.FullName | Out-File -LiteralPath $output -Encoding utf8
        } else {
            "no amcache output returned" | Out-File $output
        }
    } catch {
        "amcache parsing failed: $($_.Exception.Message)" | Out-File $output
    }
}

function Test-LogChainIntegrity {
    param([string]$LogPath)
    if (-not (Test-Path $LogPath)) { return "SKIPPED: log file not found" }

    $lines = Get-Content -LiteralPath $LogPath
    $running = "GENESIS"
    $lineNumber = 0
    for ($i = 0; $i -lt $lines.Count; $i += 2) {
        $lineNumber++
        $content_line = $lines[$i]
        $chainLine = if ($i + 1 -lt $lines.Count) { $lines[$i + 1] } else { $null }

        $expected = Get-ChainHash -PreviousHash $running -Line $content_line
        $expectedTag = "[chain:$expected]"

        if ($chainLine -ne $expectedTag) {
            return "FAILURE: chain broken at entry $lineNumber -- log may have been edited or reordered after the fact"
        }
        $running = $expected
    }
    return "SUCCESS: all $lineNumber log entries verified, chain intact"
}

function Find-SevenZip {
    $candidates = @(
        "$env:ProgramFiles\7-Zip\7z.exe",
        "${env:ProgramFiles(x86)}\7-Zip\7z.exe"
    )
    foreach ($candidate in $candidates) {
        if (Test-Path $candidate) { return $candidate }
    }
    $onPath = Get-Command "7z.exe" -ErrorAction SilentlyContinue
    if ($onPath) { return $onPath.Source }
    return $null
}

function Reset-Proxy {
    try {
        Write-MonitorLog "Resetting WinHTTP proxy (cleanup)..." Cyan -NoConsole
        $resetOut = & "$env:SystemRoot\System32\netsh.exe" winhttp reset proxy 2>&1
        foreach ($line in @($resetOut)) { Write-MonitorLog ("  {0}" -f $line) Cyan -NoConsole }
    } catch {
        Write-MonitorLog ("WARNING: failed to reset proxy in cleanup: {0}" -f $_.Exception.Message) Yellow -NoConsole
    }
}

function PackageEvidence {
    # Idempotent guard so packaging only runs once
    if ($Global:PackagingStarted) { return }
    $Global:PackagingStarted = $true

    try {
        Write-MonitorLog "Packaging evidence (triggered)..." Cyan -NoConsole

        # Reuse existing helpers defined later in the script (they'll be available at runtime).
        Show-PackagingProgress -Stage "Saving system & security info"
        Save-Text -Name "system_info.txt" -Data ($SpecsLog -join "`r`n")
        Save-Text -Name "powershell_check.txt" -Data ($psIntegrityOutput -join "`r`n")
        Save-Text -Name "security_summary.txt" -Data (($secureBootOutput + $coreIsolationOutput + $antivirusOutput + $defenderOutput) -join "`r`n")

        Show-PackagingProgress -Stage "Saving process & service info"
        Save-Command -Name "process_list.txt" -Command { & "$env:SystemRoot\System32\tasklist.exe" /v }
        Save-Command -Name "process_details.txt" -Command {
            Get-CimInstance Win32_Process | Select-Object ProcessId, Name, ExecutablePath, CommandLine | Format-List
        }
        Save-Command -Name "services_list.txt" -Command { Get-Service | Sort-Object Status, Name | Format-List }
        Save-Command -Name "driver_list.txt" -Command { & "$env:SystemRoot\System32\driverquery.exe" /v }
        Save-Command -Name "network_connections.txt" -Command { & "$env:SystemRoot\System32\netstat.exe" -abno }
        Save-Text -Name "background_services.txt" -Data ($serviceOutput -join "`r`n")

        Show-PackagingProgress -Stage "Copying prefetch & event logs"
        $logDirectory = Join-Path $outputPath "artifacts"
        New-Item -ItemType Directory -Path $logDirectory -Force | Out-Null

        $copyTargets = @("C:\Windows\Prefetch", "C:\Windows\System32\winevt\Logs")
        foreach ($target in $copyTargets) {
            if (-not (Test-Path $target)) { continue }
            $folderName = Split-Path $target -Leaf
            try {
                Copy-Item -Path $target -Destination (Join-Path $logDirectory $folderName) -Recurse -Force -ErrorAction Stop
            } catch {}
        }

        Show-PackagingProgress -Stage "Reading MUI cache & recent files"
        $muiPaths = @(
            "HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache"
            "HKCU:\Software\Microsoft\Windows\ShellNoRoam\MUICache"
        )
        $muiOutput = New-Object System.Collections.Generic.List[string]
        foreach ($muiPath in $muiPaths) {
            if (-not (Test-Path $muiPath)) { continue }
            $muiOutput.Add("registry path: $muiPath")
            try { $muiOutput.Add((Get-ItemProperty -Path $muiPath | Out-String)) }
            catch { $muiOutput.Add("failed reading muicache") }
        }
        Save-Text -Name "mui_cache.txt" -Data ($muiOutput -join "`r`n")

        $recentPath = Join-Path $env:APPDATA "Microsoft\Windows\Recent"
        if (Test-Path $recentPath) {
            Copy-Item -Path $recentPath -Destination (Join-Path $logDirectory "recent_files") -Recurse -Force -ErrorAction SilentlyContinue
        }

        Show-PackagingProgress -Stage "Parsing prefetch (PECmd)"
        Collect-Prefetch *> $null

        Show-PackagingProgress -Stage "Reading BAM history"
        Collect-BAM *> $null

        Show-PackagingProgress -Stage "Parsing Amcache"
        Collect-Amcache *> $null

        Show-PackagingProgress -Stage "Verifying session log chain"
        $logChainResult = Test-LogChainIntegrity -LogPath $monitorLogPath
        Save-Text -Name "log_chain_verification.txt" -Data $logChainResult

        Show-PackagingProgress -Stage "Generating integrity manifest"
        $manifestPath = Join-Path $outputPath "checksums.txt"
        New-IntegrityManifest -DirectoryPath $outputPath -ManifestPath $manifestPath

        Show-PackagingProgress -Stage "Creating zip archive"
        # (re-use Find-SevenZip / 7z logic already present)
        $sevenZipPath = Find-SevenZip
        $zipIsPasswordProtected = $false

        if ($sevenZipPath -and $Global:EvidenceZipPassword) {
            try {
                $sevenZipArgs = @(
                    "a", "-tzip", "-mem=AES256", "-p$($Global:EvidenceZipPassword)", "-mmt=on",
                    $zipPath, "$outputPath\*"
                )
                & $sevenZipPath @sevenZipArgs | Out-Null
                if ($LASTEXITCODE -eq 0 -and (Test-Path $zipPath)) {
                    $zipIsPasswordProtected = $true
                }
            } catch {
                $zipIsPasswordProtected = $false
            }
        }

        if (-not $zipIsPasswordProtected) {
            Compress-Archive -Path "$outputPath\*" -DestinationPath $zipPath -CompressionLevel Optimal -Force
        }

        Show-PackagingProgress -Stage "Verifying archive hash"
        $zipCrc32 = Get-Crc32 -Path $zipPath
        $zipSha256 = (Get-FileHash -LiteralPath $zipPath -Algorithm SHA256).Hash
        $zipSha512 = (Get-FileHash -LiteralPath $zipPath -Algorithm SHA512).Hash

        # Clean up working folder but keep the final zip
        Remove-Item -LiteralPath $outputPath -Recurse -Force -ErrorAction SilentlyContinue

        Write-MonitorLog ("Packaging complete. Archive: {0} SHA256: {1} Password-protected: {2}" -f $zipPath, $zipSha256, $zipIsPasswordProtected) Cyan -NoConsole

        # Always-visible summary -- not routed through the quiet logger,
        # since there's nothing left to hide once the match is over, and
        # silently swallowing the password-protection result is exactly
        # what made the "isn't password encrypted" bug invisible before.
        Write-Host ""
        Write-Host "============================================================" -ForegroundColor Green
        Write-Host "  Recording package ready" -ForegroundColor Green
        Write-Host "============================================================" -ForegroundColor Green
        Write-Host "  Folder   : $outputRoot" -ForegroundColor White
        Write-Host "  File     : $zipPath" -ForegroundColor White
        Write-Host "  SHA256   : $zipSha256" -ForegroundColor White
        if ($zipIsPasswordProtected) {
            Write-Host "  Password : Protected (AES-256 via 7-Zip)" -ForegroundColor White
        } else {
            Write-Host "  Password : NOT protected -- 7-Zip wasn't found at C:\Program Files\7-Zip\7z.exe (or on PATH), so this zip is a plain unencrypted archive. Install 7-Zip on this machine if password protection is required." -ForegroundColor Yellow
        }
        Write-Host "  Log chain: $logChainResult" -ForegroundColor White
        Write-Host "============================================================" -ForegroundColor Green

        # Reset proxy as part of cleanup
        Reset-Proxy

    } catch {
        Write-MonitorLog ("ERROR during packaging: {0}" -f $_.Exception.Message) Red
        Write-Host ""
        Write-Host "[PACKAGING FAILED] $($_.Exception.Message)" -ForegroundColor Red
        Write-Host "Evidence folder was left in place instead of being deleted, so you don't lose what was collected: $outputPath" -ForegroundColor Yellow
        # Attempt to reset proxy even on failure
        Reset-Proxy
    }
}

# Register a ProcessExit handler to attempt a final packaging/reset if the user closes the window.
try {
    [System.AppDomain]::CurrentDomain.add_ProcessExit({
        try {
            if (-not $Global:PackagingStarted) {
                # ProcessExit may run in a restricted environment; do a minimal log write
                try { Add-Content -LiteralPath $monitorLogPath -Value ("[{0}] ProcessExit triggered packaging attempt" -f (Get-Date -Format "HH:mm:ss")) } catch {}
                $Global:StopMonitoring = $true
                PackageEvidence
            }
        } catch {}
    })
} catch {
    # non-fatal if add_ProcessExit isn't available in some hosts
}

# ---------------------------
# Monitor main loop
# ---------------------------
Show-MonitorStatus
$lastStatus = Get-Date

# --- Event-driven process-creation watcher ---
#
# The poll loop below already does a full sweep every 5s. This registers a
# real-time WMI trace so a process that launches and exits inside that
# 5-second window still gets caught immediately, instead of only on the next
# scheduled poll. Falls back to poll-only detection if registration fails
# (sandboxed/locked-down environments, WMI service unavailable, etc.) rather
# than crashing the whole monitor.
$Global:AchProcessWatcherActive = $false
try {
    Register-CimIndicationEvent -ClassName Win32_ProcessStartTrace -SourceIdentifier "ACH_ProcessStart" -Action {
        try {
            Test-KnownCheatHashes
            Test-UnconfirmedHashes
            Test-KnownCheatNames
            Test-CheatFileStringSignatures
            Test-HiddenNodeDropperPattern
        } catch {}
    } -ErrorAction Stop | Out-Null
    $Global:AchProcessWatcherActive = $true
    Write-MonitorLog "Event-driven process-start watcher registered." Green -NoConsole
} catch {
    Write-MonitorLog ("Event-driven process-start watcher unavailable, relying on poll loop only: {0}" -f $_.Exception.Message) Yellow -NoConsole
}

while (-not $Global:StopMonitoring) {

    # If the console has focus and a key is available, check for Enter
    try {
        if ([System.Console]::KeyAvailable) {
            $key = [System.Console]::ReadKey($true)
            if ($key.Key -eq "Enter") {
                Write-MonitorLog "User requested stop via Enter key." Cyan
                $Global:StopMonitoring = $true
                break
            }
        }
    } catch {
        # KeyAvailable may throw if console isn't accessible; ignore and continue
    }

    # Poll-based checks (every $pollIntervalSeconds)
    if (((Get-Date) - $lastPoll).TotalSeconds -ge $pollIntervalSeconds) {
        Test-KnownCheatHashes
        Test-UnconfirmedHashes
        Test-KnownCheatNames
        Test-CheatFileStringSignatures
        Test-PyInstallerCheatArtifacts
        Test-InjectedRobloxModules
        Test-ExternalRobloxHandles -HandleExe $handleExe
        Test-HiddenNodeDropperPattern
        Test-BackgroundCpuUsage
        $lastPoll = Get-Date
    }

    # If Roblox was running earlier, and now it's not running => assume match ended; stop monitoring
    try {
        $currentRoblox = Get-Process -Name "RobloxPlayerBeta" -ErrorAction SilentlyContinue | Select-Object -First 1
        if (-not $currentRoblox -and $Global:RobloxWasRunning) {
            Write-MonitorLog "Roblox process disappeared after being present   assuming match ended." Cyan
            $Global:StopMonitoring = $true
            break
        }
    } catch {}

    if (((Get-Date) - $lastDriverScan).TotalSeconds -ge $driverScanInterval) {
        $drvResult = Test-KernelDrivers -KnownDriversUrl $Global:KNOWN_DRIVERS_URL
        $lastDriverScan = Get-Date
    }

    if (((Get-Date) - $lastPesieveScan).TotalSeconds -ge $pesieveScanInterval) {
        Test-PESieveForRoblox -ProcessName "RobloxPlayerBeta"
        Test-RobloxApiHooks -ProcessName "RobloxPlayerBeta"

        # Also point pe-sieve at anything flagged as holding an external
        # handle into Roblox -- that's usually where a memory-reading
        # external cheat actually lives, not inside Roblox itself.
        foreach ($flaggedPid in @($Global:FlaggedExternalHandlePids)) {
            Test-PESieveForRoblox -ProcessId $flaggedPid
        }

        $lastPesieveScan = Get-Date
    }

    if (((Get-Date) - $lastStatus).TotalSeconds -ge 8) {
        Show-MonitorStatus
        $lastStatus = Get-Date
    }

    Start-Sleep -Milliseconds 150
}

if ($Global:AchProcessWatcherActive) {
    try { Unregister-Event -SourceIdentifier "ACH_ProcessStart" -ErrorAction SilentlyContinue } catch {}
}

Write-Host ""
Write-ColoredLine "Match monitoring stopped." Green
Write-Host ""
Write-Host "Packaging forensic evidence -- this takes a minute, please don't close the window." -ForegroundColor Cyan
Write-Host ""

# PackageEvidence (defined earlier in this file) does the actual work: it
# writes out every log, builds the integrity manifest, creates the
# password-protected zip via 7-Zip when available, resets the WinHTTP proxy,
# and prints its own "Recording package ready" summary -- including an
# explicit warning if the zip ended up unprotected. Everything here used to
# be duplicated below (a second proxy reset, an out-of-order "Match
# complete" message printed after packaging had already finished) -- that
# duplication is removed; PackageEvidence is the single source of truth for
# what happens once monitoring stops.
PackageEvidence

if ($rebootRequired) {
    Write-Host ""
    Write-Host "[REBOOT REQUIRED] Memory Integrity was just enabled via registry -- it won't" -ForegroundColor Yellow
    Write-Host "actually be active until Windows restarts. Reboot before your next recording session." -ForegroundColor Yellow
}
