function Test-BackgroundCpuUsage {
    try {
        $counters = Get-CimInstance Win32_PerfFormattedData_PerfProc_Process -ErrorAction Stop |
            Where-Object { $_.Name -and $_.Name -ne "_Total" -and $_.Name -ne "Idle" }
    } catch {
        Write-CpuLog ("[{0}] CPU counter query failed: $($_.Exception.Message)" -f (Get-Date -Format "HH:mm:ss"))
        return
    }

    foreach ($counter in $counters) {
        $percentOfSystem = [math]::Round(($counter.PercentProcessorTime / $LogicalCoreCount), 2)
        if ($percentOfSystem -le 0.1) { continue }

        $procId = $counter.IDProcess
        $procPath = "(path unavailable)"
        try {
            $proc = Get-Process -Id $procId -ErrorAction Stop
            if ($proc.Path) { $procPath = $proc.Path }
        } catch {
            try {
                $cimMatch = Get-CimInstance Win32_Process -Filter "ProcessId = $procId" -ErrorAction Stop
                if ($cimMatch -and $cimMatch.ExecutablePath) { $procPath = $cimMatch.ExecutablePath }
            } catch {}
        }

        Write-CpuLog ("[{0}] {1} (PID {2}) CPU={3}% path='{4}'" -f (Get-Date -Format "HH:mm:ss"), $counter.Name, $procId, $percentOfSystem, $procPath)
    }
}

