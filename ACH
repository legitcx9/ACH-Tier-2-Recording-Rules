# Win32_VideoController.AdapterRAM is a 32-bit signed DWORD in WMI and
# overflows above ~4GB, so it misreports VRAM on any card with more than
# that (typically clamped to 4GB, sometimes 0 or garbage). Windows 10 1903+
# drivers separately expose the real 64-bit value in the registry under the
# Display class GUID as "HardwareInformation.qwMemorySize" -- read that
# first and only fall back to the unreliable WMI field if it's missing.
function Get-AccurateVramBytes {
    param([Parameter(Mandatory = $true)]$Gpu)

    $displayClassPath = "HKLM:\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}"
    try {
        $subKeys = Get-ChildItem -Path $displayClassPath -ErrorAction Stop |
            Where-Object { $_.PSChildName -match '^\d{4}$' }

        foreach ($key in $subKeys) {
            try {
                $props = Get-ItemProperty -Path $key.PSPath -ErrorAction Stop

                $isMatch = $false
                if ($props.MatchingDeviceId -and $Gpu.PNPDeviceID -and
                    $Gpu.PNPDeviceID -match [regex]::Escape($props.MatchingDeviceId)) {
                    $isMatch = $true
                }
                if (-not $isMatch -and $props.DriverDesc -and $Gpu.Name -and $props.DriverDesc -eq $Gpu.Name) {
                    $isMatch = $true
                }

                if ($isMatch -and $props.PSObject.Properties.Name -contains 'HardwareInformation.qwMemorySize') {
                    $bytes = $props.'HardwareInformation.qwMemorySize'
                    if ($bytes -and [uint64]$bytes -gt 0) { return [uint64]$bytes }
                }
            } catch {}
        }
    } catch {}
    return $null
}

