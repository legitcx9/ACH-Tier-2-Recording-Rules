                Write-MonitorLog $logLine Red
                break
            }
        }
    }
}

# Invoke-CheatTermination logs details to the file and prints only "LOGGED"
function Invoke-CheatTermination {
    param(
        [Parameter(Mandatory = $true)]$Process,
        [Parameter(Mandatory = $true)][string]$Reason,
        [string]$Detail = ""
    )

    $path = try { $Process.Path } catch { "" }
    $banner = "=================================================================="
    $details = @()
    $details += $banner
    $details += "CHEAT DETECTED -- TERMINATING PROCESS"
    $details += ("Process : {0} (PID {1})" -f $Process.ProcessName, $Process.Id)
    $details += ("Path    : {0}" -f $path)
    $details += ("Reason  : {0}" -f $Reason)
    if ($Detail) { $details += ("Detail  : {0}" -f $Detail) }
    try {
        $Process | Stop-Process -Force -ErrorAction Stop
        $details += "Result  : terminated successfully."
    } catch {
        $details += ("Result  : failed to terminate -- {0}" -f $_.Exception.Message)
    }
    $details += $banner

    Write-MonitorLogRaw -Lines ($details | ForEach-Object { "[{0}] {1}" -f (Get-Date -Format "HH:mm:ss"), $_ })
    Write-Host ("[{0}] LOGGED" -f (Get-Date -Format "HH:mm:ss")) -ForegroundColor Green
}

# Per-path cache so each unique file only gets hashed/scanned once, not every
# poll tick.
$Global:ScannedExeCache = @{ }

function Test-CheatFileStringSignatures {
    Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Path } | ForEach-Object {
        $proc = $_
        $path = $proc.Path

        try { $file = Get-Item -LiteralPath $path -ErrorAction Stop } catch { return }

        $fingerprint = "$($file.Length)|$($file.LastWriteTimeUtc.Ticks)"
        $cached = $Global:ScannedExeCache[$path]

        if ($cached -and $cached.Fingerprint -eq $fingerprint) {
            return
        }

        $flagged = $false
        $matchedName = ""
        $matchedMarkers = @()

        try {
            $bytes = [System.IO.File]::ReadAllBytes($path)
            $content = [System.Text.Encoding]::Latin1.GetString($bytes)

            foreach ($entryName in $CheatFileStringSignatures.Keys) {
                $hits = @()
                foreach ($marker in $CheatFileStringSignatures[$entryName]) {
                    if ($content.Contains($marker)) { $hits += $marker }
                }
                if ($hits.Count -ge 2) {
                    $flagged = $true
                    $matchedName = $entryName
                    $matchedMarkers = $hits
                    break
                } elseif ($hits.Count -eq 1) {
                    Write-MonitorLog ("SINGLE MARKER LOGGED: marker='{0}' for '{1}' -> {2} (PID {3})" -f $hits[0], $entryName, $proc.ProcessName, $proc.Id) Yellow
                }
            }
        } catch { return }

        $Global:ScannedExeCache[$path] = [pscustomobject]@{
            Fingerprint = $fingerprint
            Flagged = $flagged
            Reason = "string signature match: $matchedName ($($matchedMarkers -join ', '))"
            Detail = "Path=$path"
            Terminated = $false
        }

        if ($flagged) {
            $logLines = @()
            $logLines += "STRING-SIGNATURE FLAG"
            $logLines += ("Process: {0} (PID {1})" -f $proc.ProcessName, $proc.Id)
            $logLines += ("Path   : {0}" -f $path)
            $logLines += ("Match  : {0} -> {1}" -f $matchedName, ($matchedMarkers -join ', '))
            Write-MonitorLogRaw -Lines ($logLines | ForEach-Object { "[{0}] {1}" -f (Get-Date -Format "HH:mm:ss"), $_ })
            Write-Host ("[{0}] LOGGED" -f (Get-Date -Format "HH:mm:ss")) -ForegroundColor Green
        }
    }
}

# PyInstaller artifact detection
$PyInstallerCheatMarkers = @("mss", "cv2", "win32api.pyd", "win32gui.pyd", "keyboard", "pynput", "pyautogui")

function Test-PyInstallerCheatArtifacts {
    $tempRoots = @($env:TEMP, (Join-Path $env:LOCALAPPDATA "Temp")) | Select-Object -Unique
    foreach ($root in $tempRoots) {
        if (-not (Test-Path $root)) { continue }
        Get-ChildItem -Path $root -Directory -Filter "_MEI*" -ErrorAction SilentlyContinue | ForEach-Object {
            $meiDir = $_.FullName
            $hits = New-Object System.Collections.Generic.List[string]
            foreach ($marker in $PyInstallerCheatMarkers) {
                if (Get-ChildItem -Path $meiDir -Recurse -Filter "*$marker*" -ErrorAction SilentlyContinue | Select-Object -First 1) {
                    $hits.Add($marker)
                }
            }
            if ($hits.Count -ge 2) {
                $ownerName = $null
                $ownerPidText = $null
                $ownerPath = $null
                foreach ($candidate in (Get-Process -ErrorAction SilentlyContinue)) {
                    try {
                        $moduleHit = $candidate.Modules | Where-Object { $_.FileName -and $_.FileName.StartsWith($meiDir, [System.StringComparison]::OrdinalIgnoreCase) } | Select-Object -First 1
                        if ($moduleHit) {
                            $ownerName = $candidate.ProcessName
                            $ownerPidText = $candidate.Id
                            try { $ownerPath = $candidate.Path } catch {}
                            break
                        }
                    } catch {}
                }

                if ($ownerName) {
                    if (-not $ownerPath) { $ownerPath = "(exe path unavailable, folder: $meiDir)" }
                    Write-MonitorLog ("PyInstaller extraction signature logged: {0} -> {1} (PID {2})" -f ($hits -join ', '), $ownerName, $ownerPidText) Red
                } else {
                    Write-MonitorLog ("PyInstaller extraction signature logged: {0}, owner not resolved -- folder: {1}" -f ($hits -join ', '), $meiDir) Red
                }
            }
        }
    }
}

# ---------------------------------------------------------------------------
# Added: Hidden Node.js dropper heuristic (log-only)
# Detects node.exe processes launched via wscript.exe running a randomized .js
# filename. This is log-only because legitimate setups sometimes chain wscript->node.
# ---------------------------------------------------------------------------
function Test-HiddenNodeDropperPattern {
    try {
        $nodes = Get-CimInstance Win32_Process -Filter "Name = 'node.exe'" -ErrorAction SilentlyContinue
        foreach ($node in $nodes) {
            $parent = Get-CimInstance Win32_Process -Filter ("ProcessId = {0}" -f $node.ParentProcessId) -ErrorAction SilentlyContinue
            if (-not $parent) { continue }

            $parentIsWscript = $false
            try { $parentIsWscript = ($parent.Name -match '^wscript\.exe$') } catch {}

            $cmd = $node.CommandLine -as [string]
            $looksRandomized = $false
            if ($cmd -and $cmd -match '[a-zA-Z0-9]{10,}\.js') { $looksRandomized = $true }

            if ($parentIsWscript -and $looksRandomized) {
                Write-MonitorLog ("SUSPECTED HIDDEN DROPPER LOGGED: node.exe (PID {0}) spawned by wscript.exe (PID {1}), cmdline='{2}'" -f $node.ProcessId, $parent.ProcessId, $cmd) Yellow
            }
        }
    } catch {
        # don't raise; this is a best-effort log-only heuristic
    }
}

