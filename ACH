function Get-ForensicTool {
    param(
        [Parameter(Mandatory = $true)][string]$Name,
        [Parameter(Mandatory = $true)][string]$ZipUrl,
        [Parameter(Mandatory = $true)][string]$ExeFilter,
        [string[]]$ExcludeMatch = @()
    )

    $toolRoot = Join-Path $PersistentToolsRoot $Name
    $zipPath = Join-Path $PersistentToolsRoot "$Name.zip"

    $filterExisting = {
        param($items)
        if ($ExcludeMatch.Count -eq 0) { return $items }
        return $items | Where-Object {
            $candidate = $_
            $skip = $false
            foreach ($pattern in $ExcludeMatch) {
                if ($candidate.FullName -match $pattern) { $skip = $true }
            }
            -not $skip
        }
    }

    # Shared by both the "already cached" check below and the post-extraction
    # check further down, so a naming drift in the release zip (version
    # suffix, arch tag, casing) is handled the same way in both places
    # instead of only on a fresh download.
    $findExe = {
        param($root, $filter)
        $found = & $filterExisting (Get-ChildItem -Path $root -Filter $filter -Recurse -ErrorAction SilentlyContinue) |
            Select-Object -First 1
        if ($found) { return $found }

        $stem = [System.IO.Path]::GetFileNameWithoutExtension($filter) -replace '[\d\.]+$', ''
        if ($stem) {
            $found = & $filterExisting (Get-ChildItem -Path $root -Filter "*$stem*.exe" -Recurse -ErrorAction SilentlyContinue) |
                Select-Object -First 1
        }
        return $found
    }

    if (Test-Path $toolRoot) {
        $existingExe = & $findExe $toolRoot $ExeFilter
        if ($existingExe) {
            Write-ColoredLine "[OK] $Name already cached, skipping download." Green
            return $existingExe
        }
    }

    try {
        Write-ColoredLine "Fetching $Name..." Cyan
        Save-RemoteFile -Uri $ZipUrl -Path $zipPath
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        if (Test-Path $toolRoot) {
            # A prior attempt left a partial/mismatched extraction here (e.g.
            # its exe wasn't found by the filter above, so we're retrying) --
            # ExtractToDirectory throws "already exists" into a non-empty
            # folder, so clear it first rather than fail every run after the
            # first bad one.
            Remove-Item -LiteralPath $toolRoot -Recurse -Force -ErrorAction SilentlyContinue
        }
        [System.IO.Compression.ZipFile]::ExtractToDirectory($zipPath, $toolRoot)
        Remove-Item -LiteralPath $zipPath -Force -ErrorAction SilentlyContinue
        Write-ColoredLine "[OK] $Name ready." Green
    } catch {
        Write-ColoredLine "[FAIL] Couldn't fetch $Name`: $($_.Exception.Message)" Red
        return $null
    }

    $exe = & $findExe $toolRoot $ExeFilter

    if (-not $exe) {
        Write-ColoredLine "[FAIL] $ExeFilter missing after extracting $Name." Red
        # Show what actually came out of the zip instead of just "missing" --
        # this is the difference between a one-line log entry a reviewer can
        # act on (rename the filter, or the release changed layout) and a
        # dead end.
        $foundFiles = Get-ChildItem -Path $toolRoot -Recurse -ErrorAction SilentlyContinue | Select-Object -First 25 -ExpandProperty Name
        if ($foundFiles) {
            Write-ColoredLine ("       Extracted files instead: {0}" -f ($foundFiles -join ', ')) Yellow
        } else {
            Write-ColoredLine "       Extracted folder appears empty." Yellow
        }
    }
    return $exe
}

function Stop-ToolProcess {
    param([string[]]$ProcessNames)
    $running = Get-Process -ErrorAction SilentlyContinue |
        Where-Object { $ProcessNames -contains $_.ProcessName.ToLower() }
    foreach ($proc in $running) {
        try {
            $proc | Stop-Process -Force -ErrorAction Stop
            Write-ColoredLine "[OK] Closed existing instance (PID $($proc.Id))." Green
        } catch {
            Write-ColoredLine "[WARN] Couldn't close PID $($proc.Id): $($_.Exception.Message)" Yellow
        }
    }
    if ($running) { Start-Sleep -Seconds 1 }
}

