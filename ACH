# ---------------------------
# Kernel driver / BYOVD detection (suppressed console listing)
# ---------------------------
function Test-KernelDrivers {
    param(
        [string]$KnownDriversUrl = $Global:KNOWN_DRIVERS_URL,
        [int]$MaxDriverNameLen = 80
    )

    $suspects = New-Object System.Collections.ArrayList
    $infoLines = New-Object System.Collections.ArrayList
    $knownDrivers = @{ }

    # Fetched once per session and cached on $Global:KnownDriversCache --
    # re-downloading the same list every 60s for the whole match was both
    # wasteful and, on a slow/blocked network, a repeated chance to stall
    # the monitoring loop. $Global:KnownDriversCacheAttempted remembers a
    # failed fetch so we don't keep retrying (and re-risking a timeout)
    # every single scan -- one skipped fetch just means this scan falls
    # back to the local signature/temp-path/unsigned-driver heuristics below.
    if ($null -eq $Global:KnownDriversCache -and -not $Global:KnownDriversCacheAttempted) {
        $Global:KnownDriversCacheAttempted = $true
        $Global:KnownDriversCache = @{ }
        if ($KnownDriversUrl) {
            try {
                $json = Invoke-RestMethod -Uri $KnownDriversUrl -UseBasicParsing -TimeoutSec 8 -ErrorAction Stop
                if ($json -is [System.Collections.IDictionary]) {
                    foreach ($k in $json.Keys) { $Global:KnownDriversCache[$k.ToLower()] = $json[$k] }
                } elseif ($json -is [System.Array]) {
                    foreach ($entry in $json) {
                        $nm = if ($entry -is [string]) { $entry } else { $entry.name -as [string] }
                        if ($nm) { $Global:KnownDriversCache[$nm.ToLower()] = $true }
                    }
                }
            } catch {
                # write fetch warning to the log but don't spam console
                Write-MonitorLog ("WARNING: Couldn't fetch known-driver list: {0}" -f $_.Exception.Message) Yellow
            }
        }
    }
    $knownDrivers = $Global:KnownDriversCache
    if ($null -eq $knownDrivers) { $knownDrivers = @{ } }

    try {
        $drivers = Get-CimInstance Win32_SystemDriver -ErrorAction Stop
    } catch {
        Write-MonitorLog ("WARNING: Couldn't enumerate Win32_SystemDriver: {0}" -f $_.Exception.Message) Yellow
        return @{
            Summary = "driver-scan-failed"
            SuspectCount = 0
        }
    }

    foreach ($d in $drivers) {
        $name = $d.Name
        $state = $d.State
        $pathRaw = $d.PathName -as [string]
        if ($pathRaw) { $path = $pathRaw.Trim('"') } else { $path = $null }

        $flagged = $false
        $reasons = @()

        if ($path) {
            try {
                # try to normalize file path
                $filePath = $path -replace '^\^?', '' -replace '\s+.*$',''
                if (Test-Path $filePath) {
                    try {
                        $sig = Get-AuthenticodeSignature -FilePath $filePath -ErrorAction Stop
                        if ($sig.Status -ne 'Valid' -or (-not ($sig.SignerCertificate.Subject -match "Microsoft|Microsoft Corporation|Microsoft Windows"))) {
                            $flagged = $true
                            $reasons += "unsigned-or-non-Microsoft-signer ($($sig.Status))"
                        }
                    } catch {
                        $flagged = $true
                        $reasons += "signature-check-failed"
                    }

                    if ($filePath -match "\\(Temp|Downloads|AppData\\Local\\Temp)\\" -or $filePath -match "\\Users\\[^\\]+\\Downloads\\") {
                        $flagged = $true
                        $reasons += "loaded-from-temp-or-downloads"
                    }
                } else {
                    $flagged = $true
                    $reasons += "driver-file-not-found"
                }
            } catch {}
        } else {
            $flagged = $true
            $reasons += "no-path-recorded"
        }

        $baseName = if ($path) { [IO.Path]::GetFileName($path).ToLower() } else { $name.ToLower() }
        if ($knownDrivers.ContainsKey($baseName)) {
            $flagged = $true
            $reasons += "known-abusable-driver"
        }

        $info = @{
            Name = $name
            State = $state
            Path = $path
            Flagged = $flagged
            Reasons = $reasons
        }

        # Always append details to the internal list (for logging), but only
        # surface a compact console summary later.
        if ($flagged) {
            $null = $suspects.Add((New-Object psobject -Property $info)) > $null
        } else {
            $null = $infoLines.Add("driver ok: $name | state: $state | path: $path") > $null
        }
    }

    # Write full details to the session log (for forensic review), but keep
    # console output short:
    $logLines = @()
    $logLines += ("[Driver Scan @ {0}]" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"))
    $logLines += ("driver count: {0}" -f $drivers.Count)
    $logLines += ("suspects: {0}" -f $suspects.Count)
    $logLines += ""

    foreach ($s in $suspects) {
        $logLines += ("SUSPECT DRIVER: {0} | state: {1} | path: {2} | reasons: {3}" -f $s.Name, $s.State, $s.Path, ($s.Reasons -join ', '))
    }

    # also include a small sampling of benign info if needed (but don't spam)
    if ($infoLines.Count -gt 0) {
        $sample = $infoLines | Select-Object -First 10
        $logLines += ""
        $logLines += "INFO: sample of non-flagged drivers (first 10)"
        $logLines += $sample
    }

    # write full driver scan to session log
    Write-MonitorLogRaw -Lines ($logLines | ForEach-Object { "[{0}] {1}" -f (Get-Date -Format "HH:mm:ss"), $_ })

    # Console summary only
    if ($suspects.Count -gt 0) {
        Write-Host ("[{0}] DRIVER SCAN: Driver Logged: {1}" -f (Get-Date -Format "HH:mm:ss"), $suspects.Count) -ForegroundColor Green
    } else {
        Write-Host ("[{0}] DRIVER SCAN: No suspicious drivers found" -f (Get-Date -Format "HH:mm:ss")) -ForegroundColor Green
    }

    return @{
        Summary = "driver-scan-complete"
        SuspectCount = $suspects.Count
        Suspects = $suspects
    }
}

# ---------------------------
# PESieve (memory-region / manual-mapped module) integration
# ---------------------------
function Test-PESieveForRoblox {
    # Scans a process for injected/manual-mapped modules and RWX regions.
    # Takes either -ProcessName (used for Roblox itself) or -ProcessId
    # directly, so the same scan can also be pointed at any process that
    # Test-ExternalRobloxHandles flagged as holding a handle into Roblox --
    # that's usually where an *external* cheat/reader process actually lives,
    # not inside Roblox itself.
    param(
        [string]$ProcessName,
        [int]$ProcessId
    )

    $results = New-Object System.Collections.Generic.List[string]

    $proc = $null
    if ($ProcessId) {
        $proc = Get-Process -Id $ProcessId -ErrorAction SilentlyContinue
        if (-not $proc) { $results.Add("INFO: PID $ProcessId no longer running"); return $results }
    } else {
        if (-not $ProcessName) { $ProcessName = "RobloxPlayerBeta" }
        $proc = Get-Process -Name $ProcessName -ErrorAction SilentlyContinue | Select-Object -First 1
        if (-not $proc) {
            $results.Add("INFO: $ProcessName not running")
            return $results
        }
    }

    if (-not $Global:PESIEVE_URL) {
        $results.Add("WARNING: PESieve URL not configured; skipping memory-region scan")
        return $results
    }

    $pesieveExe = Get-ForensicTool -Name "PESieve" -ZipUrl $Global:PESIEVE_URL -ExeFilter "pe-sieve64.exe"
    if (-not $pesieveExe) {
        $results.Add("FAIL: pesieve not available")
        return $results
    }

    if ($Global:PESIEVE_EXPECTED_SHA256) {
        try {
            $actual = (Get-FileHash -LiteralPath $pesieveExe.FullName -Algorithm SHA256).Hash
            if ($actual -ne $Global:PESIEVE_EXPECTED_SHA256) {
                $results.Add("FAIL: Pesieve binary hash mismatch (found $actual)")
                return $results
            }
        } catch {
            $results.Add("WARNING: Failed to check pesieve hash: $($_.Exception.Message)")
        }
    }

    $jsonOut = Join-Path $env:TEMP ("pesieve_out_{0}_{1}.json" -f $proc.Id, (Get-Random))
    $exe = $pesieveExe.FullName

    try {
        $args = @("-pid", $proc.Id.ToString(), "-sc", "-o", $jsonOut, "-silent")
        & $exe @args 2>$null | Out-Null
        Start-Sleep -Milliseconds 300
    } catch {
        $results.Add("ERROR: pesieve execution failed: $($_.Exception.Message)")
        return $results
    }

    if (-not (Test-Path $jsonOut)) {
        try {
            $raw = & $exe -pid $proc.Id -sc -silent 2>$null
            foreach ($line in $raw) {
                if ($line -match '(Infected|suspicious|Injected|Manual map|RWX)') {
                    Write-MonitorLog ("PE-sieve detection logged: {0}" -f $line) Red
                    $results.Add("LOG: $line")
                }
            }
        } catch {
            $results.Add("ERROR: pesieve run/no output: $($_.Exception.Message)")
        }
        return $results
    }

    try {
        $jsonText = Get-Content -LiteralPath $jsonOut -Raw -ErrorAction Stop
        $parsed = ConvertFrom-Json -InputObject $jsonText -ErrorAction Stop

        if ($parsed.results) {
            foreach ($r in $parsed.results) {
                if ($r.scan_result -and $r.scan_result -ne "OK") {
                    $msg = "PESieve result: $($r.module_name) -> $($r.scan_result)"
                    Write-MonitorLog $msg Red
                    $results.Add($msg)
                }
            }
        } elseif ($parsed.infections) {
            foreach ($inf in $parsed.infections) {
                $msg = "PESieve infection: $($inf.module) -> $($inf.details)"
                Write-MonitorLog $msg Red
                $results.Add($msg)
            }
        } else {
            $text = $jsonText
            if ($text -match '(injected|manual map|RWX|suspicious|IAT hook)') {
                Write-MonitorLog "PESieve produced suspicious markers" Red
                $results.Add("LOG: pesieve produced suspicious markers")
            } else {
                $results.Add("INFO: pesieve scan completed, no obvious hits")
            }
        }
    } catch {
        $results.Add("WARNING: Couldn't parse pesieve output: $($_.Exception.Message)")
    } finally {
        try { Copy-Item -LiteralPath $jsonOut -Destination (Join-Path $outputPath ("pesieve_{0}.json" -f $proc.Id)) -Force -ErrorAction SilentlyContinue } catch {}
    }

    return $results
}

# ---------------------------
# Basic in-memory API hook detection (ntdll/kernel32) for Roblox
# ---------------------------
#
# Compares the first bytes of a handful of commonly-hooked functions inside
# RobloxPlayerBeta's mapped ntdll.dll/kernel32.dll against the same bytes at
# the same address in *this* PowerShell process. System DLLs like ntdll and
# kernel32 are relocated once per boot and every process maps the same
# already-relocated copy, so under normal circumstances the bytes at a given
# function's address should be identical between any two processes on the
# same running system. A mismatch means something patched the function
# inside Roblox specifically (a classic API-hooking technique used by
# hook-based cheats/overlays that never show up as a separate loaded module).
#
# Known limitation: this assumes the verifying process (this script) is
# itself clean, and that both processes see the same relocated base for the
# system DLL -- true by default, but some additional hardening policies can
# force independent per-process randomization, which would produce false
# positives here. Treat hits as a lead for human review, same as everything
# else in this monitor, not an automatic verdict.

if (-not ([System.Management.Automation.PSTypeName]"AchHookCheck").Type) {
    Add-Type @"
using System;
using System.Runtime.InteropServices;

public static class AchHookCheck
{
    [DllImport("kernel32.dll", SetLastError = true)]
    public static extern IntPtr OpenProcess(int dwDesiredAccess, bool bInheritHandle, int dwProcessId);

    [DllImport("kernel32.dll", SetLastError = true)]
    public static extern bool ReadProcessMemory(IntPtr hProcess, IntPtr lpBaseAddress, byte[] lpBuffer, int dwSize, out int lpNumberOfBytesRead);

    [DllImport("kernel32.dll", SetLastError = true)]
    public static extern bool CloseHandle(IntPtr hObject);

    [DllImport("kernel32.dll", CharSet = CharSet.Auto, SetLastError = true)]
    public static extern IntPtr GetModuleHandle(string lpModuleName);

    [DllImport("kernel32.dll", CharSet = CharSet.Ansi, SetLastError = true, BestFitMapping = false, ThrowOnUnmappableChar = true)]
    public static extern IntPtr GetProcAddress(IntPtr hModule, string procName);
}
"@
}

$AchHookCheckFunctions = @(
    @{ Module = "ntdll.dll";    Name = "NtReadVirtualMemory" }
    @{ Module = "ntdll.dll";    Name = "NtWriteVirtualMemory" }
    @{ Module = "ntdll.dll";    Name = "NtProtectVirtualMemory" }
    @{ Module = "ntdll.dll";    Name = "NtQuerySystemInformation" }
    @{ Module = "kernel32.dll"; Name = "VirtualProtect" }
    @{ Module = "kernel32.dll"; Name = "CreateRemoteThread" }
)
$PROCESS_VM_READ = 0x0010
$PROCESS_QUERY_INFORMATION = 0x0400

function Test-RobloxApiHooks {
    param([string]$ProcessName = "RobloxPlayerBeta")

    $proc = Get-Process -Name $ProcessName -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $proc) { return }

    $hProcess = [AchHookCheck]::OpenProcess($PROCESS_VM_READ -bor $PROCESS_QUERY_INFORMATION, $false, $proc.Id)
    if ($hProcess -eq [IntPtr]::Zero) {
        Write-MonitorLog "Hook scan: couldn't open RobloxPlayerBeta for VM read (insufficient rights or process gone)" Yellow -NoConsole
        return
    }

    try {
        foreach ($target in $AchHookCheckFunctions) {
            try {
                $hModule = [AchHookCheck]::GetModuleHandle($target.Module)
                if ($hModule -eq [IntPtr]::Zero) { continue }
                $procAddr = [AchHookCheck]::GetProcAddress($hModule, $target.Name)
                if ($procAddr -eq [IntPtr]::Zero) { continue }

                $localBytes = New-Object byte[] 16
                [Runtime.InteropServices.Marshal]::Copy($procAddr, $localBytes, 0, 16)

                $remoteBytes = New-Object byte[] 16
                $bytesRead = 0
                $ok = [AchHookCheck]::ReadProcessMemory($hProcess, $procAddr, $remoteBytes, 16, [ref]$bytesRead)
                if (-not $ok -or $bytesRead -lt 16) { continue }

                $differs = $false
                for ($i = 0; $i -lt 16; $i++) {
                    if ($localBytes[$i] -ne $remoteBytes[$i]) { $differs = $true; break }
                }

                if ($differs) {
                    $localHex = ($localBytes | ForEach-Object { $_.ToString("X2") }) -join " "
                    $remoteHex = ($remoteBytes | ForEach-Object { $_.ToString("X2") }) -join " "
                    Write-MonitorLog ("API hook logged in {0}: {1}!{2} differs from clean baseline (clean=[{3}] roblox=[{4}])" -f $ProcessName, $target.Module, $target.Name, $localHex, $remoteHex) Red
                }
            } catch {}
        }
    } finally {
        [AchHookCheck]::CloseHandle($hProcess) | Out-Null
    }
}

