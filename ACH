# Centralized logging function: always writes full line(s) to the session log.
# Console printing is minimized by default; set $Global:MonitorQuiet = $false to see full console output.
function Write-MonitorLog {
    param(
        [Parameter(Mandatory = $true)][string]$Line,
        [ConsoleColor]$Color = 'White',
        [Switch]$NoConsole
    )

    $stamped = "[{0}] {1}" -f (Get-Date -Format "HH:mm:ss"), $Line

    try {
        $Global:LogChainHash = Get-ChainHash -PreviousHash $Global:LogChainHash -Line $stamped
        Add-Content -LiteralPath $monitorLogPath -Value $stamped
        Add-Content -LiteralPath $monitorLogPath -Value "[chain:$Global:LogChainHash]"
    } catch {
        # don't throw if logging fails
    }

    if ($NoConsole) { return }

    if ($Global:MonitorQuiet) {
        # Minimal console feedback: single green LOGGED line
        $shortStamp = "[{0}] LOGGED" -f (Get-Date -Format "HH:mm:ss")
        Write-Host $shortStamp -ForegroundColor Green
    } else {
        Write-Host $stamped -ForegroundColor $Color
    }
}

# Write multiple raw lines to the monitor log (used for multi-line entries)
function Write-MonitorLogRaw {
    param([Parameter(Mandatory = $true)][string[]]$Lines)
    foreach ($l in $Lines) {
        try {
            $Global:LogChainHash = Get-ChainHash -PreviousHash $Global:LogChainHash -Line $l
            Add-Content -LiteralPath $monitorLogPath -Value $l
            Add-Content -LiteralPath $monitorLogPath -Value "[chain:$Global:LogChainHash]"
        } catch {}
    }
    if (-not $Global:MonitorQuiet) {
        foreach ($l in $Lines) { Write-Host $l -ForegroundColor White }
    } else {
        Write-Host ("[{0}] LOGGED" -f (Get-Date -Format "HH:mm:ss")) -ForegroundColor Green
    }
}

