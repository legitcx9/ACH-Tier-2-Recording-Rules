function Test-KnownCheatHashes {
    Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Path } | ForEach-Object {
        try {
            $hash = (Get-FileHash -LiteralPath $_.Path -Algorithm SHA256 -ErrorAction Stop).Hash
            if ($KnownCheatHashes.ContainsKey($hash)) {
                Invoke-CheatTermination -Process $_ -Reason "known hash match: $($KnownCheatHashes[$hash])" -Detail "SHA256=$hash"
            }
        } catch {}
    }
}

# Log-only counterpart to Test-KnownCheatHashes -- see the $UnconfirmedHashes note
# above. Never calls Invoke-CheatTermination; a match here is a "get a human to look
# at this" signal for the reviewer, not a verdict.
function Test-UnconfirmedHashes {
    Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Path } | ForEach-Object {
        $proc = $_
        try {
            $hash = (Get-FileHash -LiteralPath $proc.Path -Algorithm SHA256 -ErrorAction Stop).Hash
            if ($UnconfirmedHashes.ContainsKey($hash)) {
                Write-MonitorLog "NOTICE (unconfirmed submitted-sample hash match, NOT auto-terminated -- flag for human review: $($UnconfirmedHashes[$hash])): $($proc.ProcessName) (PID $($proc.Id)) path='$($proc.Path)' SHA256=$hash" Yellow
            }
        } catch {}
    }
}

function Test-KnownCheatNames {
    Get-Process -ErrorAction SilentlyContinue | ForEach-Object {
        $proc = $_
        $haystack = @($proc.ProcessName, $proc.MainWindowTitle) -join " "
        $procPath = ""
        try { if ($proc.Path) { $procPath = $proc.Path; $haystack += " " + $procPath } } catch {}
        try { $haystack += " " + $proc.MainModule.FileVersionInfo.ProductName } catch {}
        if (-not $procPath) {
            # Path property can come back empty for some processes even when the
            # OS will still hand it back via CIM -- try that before giving up, so
            # the log always pinpoints a location when one exists.
            try {
                $cimMatch = Get-CimInstance Win32_Process -Filter "ProcessId = $($proc.Id)" -ErrorAction Stop
                if ($cimMatch -and $cimMatch.ExecutablePath) { $procPath = $cimMatch.ExecutablePath }
            } catch {}
        }
        if (-not $procPath) { $procPath = "(path unavailable -- process may have exited or is protected)" }

        foreach ($fragment in $KnownCheatNameFragments) {
            if ($haystack -match [regex]::Escape($fragment)) {
                Write-MonitorLog "FLAGGED (name/title match '$fragment'): $($proc.ProcessName) (PID $($proc.Id)) title='$($proc.MainWindowTitle)' path='$procPath'" Red
                break
            }
        }
    }
}

# --- POLICY NOTE: this script is otherwise detect-and-log only (see the header ------
# --- comment above the MATCH MONITORING section). Invoke-CheatTermination is the ---
# --- one deliberate exception, and it is scoped narrowly on purpose:
#   - Test-KnownCheatHashes: an exact SHA-256 match against a binary someone has
#     personally reviewed line-by-line. This is the same confidence level real AV
#     products act on automatically.
#   - Test-CheatFileStringSignatures: 2+ independent, distinctive byte-string
#     markers pulled from a reviewed sample, found together in the same file. A
#     single marker is not enough to terminate (logged only, see the function) --
#     only a multi-marker match does, to keep the false-positive rate low.
# Every other check in this file (name/title fragments, PyInstaller artifacts,
# unsigned Roblox modules, external handles) stays detect-and-log, because those
# signals alone are too weak to justify killing a process automatically -- a
# window titled "Trigger Point" or a legitimate overlay tool opening a handle to
# Roblox would otherwise get killed on a false positive. If you add new hash or
# string-signature entries above, only add ones you've personally reviewed.
function Invoke-CheatTermination {
    param(
        [Parameter(Mandatory = $true)]$Process,
        [Parameter(Mandatory = $true)][string]$Reason,
        [string]$Detail = ""
    )

    $path = try { $Process.Path } catch { "" }
    $banner = "=================================================================="
    Write-MonitorLog $banner Red
    Write-MonitorLog "CHEAT DETECTED -- TERMINATING PROCESS" Red
    Write-MonitorLog "Process : $($Process.ProcessName) (PID $($Process.Id))" Red
    Write-MonitorLog "Path    : $path" Red
    Write-MonitorLog "Reason  : $Reason" Red
    if ($Detail) { Write-MonitorLog "Detail  : $Detail" Red }

    try {
        $Process | Stop-Process -Force -ErrorAction Stop
        Write-MonitorLog "Result  : terminated successfully." Green
    } catch {
        Write-MonitorLog "Result  : FAILED to terminate -- $($_.Exception.Message)" Red
    }
    Write-MonitorLog $banner Red
}

# --- Per-file-path cache so hashing/string-scanning every running process's image --
# --- happens once per unique file, not on every 5-second poll tick. Keyed on the ---
# --- executable path; invalidated if the file's size or last-write time changes ---
# --- (covers a cheat that gets replaced on disk mid-match under the same path). ----
$Global:ScannedExeCache = @{}

function Test-CheatFileStringSignatures {
    Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Path } | ForEach-Object {
        $proc = $_
        $path = $proc.Path

        try {
            $file = Get-Item -LiteralPath $path -ErrorAction Stop
        } catch {
            return
        }

        $cacheKey = $path
        $fingerprint = "$($file.Length)|$($file.LastWriteTimeUtc.Ticks)"
        $cached = $Global:ScannedExeCache[$cacheKey]

        if ($cached -and $cached.Fingerprint -eq $fingerprint) {
            if ($cached.Flagged -and -not $cached.Terminated) {
                Invoke-CheatTermination -Process $proc -Reason $cached.Reason -Detail $cached.Detail
                $cached.Terminated = $true
            }
            return
        }

        # New or changed file -- read it once, scan for signature markers.
        $flagged = $false
        $matchedName = ""
        $matchedMarkers = @()

        try {
            $bytes = [System.IO.File]::ReadAllBytes($path)
            # Latin1 keeps a 1:1 byte-to-char mapping so ASCII marker substrings
            # inside a mixed binary blob are found the same way `strings` finds them.
            $content = [System.Text.Encoding]::Latin1.GetString($bytes)

            foreach ($entryName in $CheatFileStringSignatures.Keys) {
                $hits = @()
                foreach ($marker in $CheatFileStringSignatures[$entryName]) {
                    if ($content.Contains($marker)) { $hits += $marker }
                }
                if ($hits.Count -ge 2) {
                    $flagged = $true
                    $matchedName = $entryName
                    $matchedMarkers = $hits
                    break
                } elseif ($hits.Count -eq 1) {
                    # Single marker: log only, don't terminate -- see POLICY NOTE.
                    Write-MonitorLog "NOTICE (single marker '$($hits[0])' for '$entryName', not enough to act on alone): $($proc.ProcessName) (PID $($proc.Id)) [$path]" Yellow
                }
            }
        } catch {
            # Locked/inaccessible file this poll -- try again next poll, don't cache.
            return
        }

        $Global:ScannedExeCache[$cacheKey] = [pscustomobject]@{
            Fingerprint = $fingerprint
            Flagged = $flagged
            Reason = "string signature match: $matchedName ($($matchedMarkers -join ', '))"
            Detail = "Path=$path"
            Terminated = $false
        }

        if ($flagged) {
            $Global:ScannedExeCache[$cacheKey].Terminated = $true
            Invoke-CheatTermination -Process $proc -Reason $Global:ScannedExeCache[$cacheKey].Reason -Detail $Global:ScannedExeCache[$cacheKey].Detail
        }
    }
}

# --- C) Generic PyInstaller-onefile extraction artifacts in %TEMP% -----------------
# Any onefile PyInstaller exe (the format this analyzed colorbot uses, and the
# format most homemade Python Roblox cheats use) unpacks itself into a folder named
# _MEIxxxxxx under %TEMP% while it's running. Catches renamed/recompiled variants
# of the same tool family, not just the one reviewed hash above.
$PyInstallerCheatMarkers = @("mss", "cv2", "win32api.pyd", "win32gui.pyd", "keyboard", "pynput", "pyautogui")

function Test-PyInstallerCheatArtifacts {
    $tempRoots = @($env:TEMP, (Join-Path $env:LOCALAPPDATA "Temp")) | Select-Object -Unique
    foreach ($root in $tempRoots) {
        if (-not (Test-Path $root)) { continue }
        Get-ChildItem -Path $root -Directory -Filter "_MEI*" -ErrorAction SilentlyContinue | ForEach-Object {
            $meiDir = $_.FullName
            $hits = New-Object System.Collections.Generic.List[string]
            foreach ($marker in $PyInstallerCheatMarkers) {
                if (Get-ChildItem -Path $meiDir -Recurse -Filter "*$marker*" -ErrorAction SilentlyContinue | Select-Object -First 1) {
                    $hits.Add($marker)
                }
            }
            # 2+ marker hits in the same _MEI extraction folder is the colorbot/aimbot
            # module signature (screen-capture lib + vision lib or input-control lib
            # together); a single hit alone is too common in legitimate Python tools
            # to flag on its own.
            if ($hits.Count -ge 2) {
                # Identify the owning process: a onefile PyInstaller bootloader loads
                # its unpacked DLLs directly out of its own _MEI folder, so whichever
                # running process has a loaded module whose path sits under $meiDir
                # is the process that created it -- this pins down name + on-disk
                # location of the actual .exe, not just the temp extraction folder.
                $ownerName = $null
                $ownerPidText = $null
                $ownerPath = $null
                foreach ($candidate in (Get-Process -ErrorAction SilentlyContinue)) {
                    try {
                        $moduleHit = $candidate.Modules | Where-Object { $_.FileName -and $_.FileName.StartsWith($meiDir, [System.StringComparison]::OrdinalIgnoreCase) } | Select-Object -First 1
                        if ($moduleHit) {
                            $ownerName = $candidate.ProcessName
                            $ownerPidText = $candidate.Id
                            try { $ownerPath = $candidate.Path } catch {}
                            break
                        }
                    } catch {}
                }

                if ($ownerName) {
                    if (-not $ownerPath) { $ownerPath = "(exe path unavailable, extraction folder: $meiDir)" }
                    Write-MonitorLog "FLAGGED (PyInstaller extraction signature: $($hits -join ', ')): $ownerName (PID $ownerPidText) path='$ownerPath'" Red
                } else {
                    Write-MonitorLog "FLAGGED (PyInstaller extraction signature: $($hits -join ', ')), owning process not resolved -- extraction folder: $meiDir" Red
                }
            }
        }
    }
}

# --- D) Modules loaded into RobloxPlayerBeta.exe not signed by Roblox/Microsoft ----
function Test-InjectedRobloxModules {
    $robloxProcs = Get-Process -Name "RobloxPlayerBeta" -ErrorAction SilentlyContinue
    foreach ($proc in $robloxProcs) {
        try {
            foreach ($module in $proc.Modules) {
                $path = $module.FileName
                if (-not $path) { continue }
                $inTempOrDownloads = $path -match "\\(Temp|Downloads|AppData\\Local\\Temp)\\"
                $sig = $null
                try { $sig = Get-AuthenticodeSignature -LiteralPath $path -ErrorAction Stop } catch {}
                $trustedSigner = $sig -and $sig.Status -eq "Valid" -and $sig.SignerCertificate.Subject -match "Roblox|Microsoft"

                if ($inTempOrDownloads -or -not $trustedSigner) {
                    Write-MonitorLog "FLAGGED (unsigned/suspicious module in Roblox process PID $($proc.Id)): $path" Red
                }
            }
        } catch {}
    }
}

# --- E) External processes holding an open handle directly to RobloxPlayerBeta's ---
# --- process object -- the pattern used by "external" executors/aimbots that never --
# --- inject a DLL at all (several of the tools researched for this list advertise ---
# --- exactly this as a selling point: "runs outside the Roblox process"). Uses -----
# --- Sysinternals handle.exe (same publisher/domain this script already trusts for -
# --- Process Explorer/Autoruns) in its documented search mode, which lists every ---
# --- handle in the system whose target object name matches "RobloxPlayerBeta". -----
# NOTE: handle.exe's exact line format has changed across versions, so this parses
# defensively (two possible layouts) rather than assuming one. If you see it miss or
# over-flag on your Sysinternals version, run `handle64.exe -a -nobanner -accepteula
# RobloxPlayerBeta` by hand once and adjust the two regexes below to match.
$RobloxHandleOwnerAllowlist = @(
    "RobloxPlayerBeta", "System", "Registry", "csrss", "wininit", "services",
    "dwm", "explorer", "svchost", "audiodg", "conhost", "powershell", "pwsh",
    "handle64", "handle", "procexp64", "procexp", "procexp64a", "SearchHost",
    "ShellExperienceHost", "ApplicationFrameHost", "sihost", "RuntimeBroker",
    "smss", "lsass", "WmiPrvSE", "MsMpEng", "SecurityHealthService",
    # Common legitimate overlay/recording software that hooks into game processes
    # for on-screen overlays -- these WILL show up here and are expected. Add your
    # own recording/streaming/voice-chat software here if it gets flagged.
    "Discord", "GameOverlayUI", "obs64", "obs32", "RTSS", "MSIAfterburner",
    "NVIDIA Share", "nvcontainer", "SteamOverlayRenderer", "XboxGameBarWidgets"
)

function Test-ExternalRobloxHandles {
    param($HandleExe)
    if (-not $HandleExe) { return }
    if (-not (Get-Process -Name "RobloxPlayerBeta" -ErrorAction SilentlyContinue)) { return }

    try {
        $rawOutput = & $HandleExe.FullName -a -nobanner -accepteula "RobloxPlayerBeta" 2>$null
    } catch {
        return
    }
    if (-not $rawOutput) { return }

    $currentOwner = $null
    $currentOwnerPid = $null

    foreach ($line in $rawOutput) {
        $ownerName = $null
        $ownerPid = $null

        # Layout A: owner + handle info on one consolidated line.
        if ($line -match '^(?<owner>[^\s].*?\.exe)\s+pid:\s+(?<pid>\d+).*RobloxPlayerBeta\.exe') {
            $ownerName = $Matches['owner']
            $ownerPid = $Matches['pid']
        }
        # Layout B: a section header line ("owner.exe   pid: NNNN") followed by
        # separate indented handle lines -- track the header, match on later lines.
        elseif ($line -match '^(?<owner>[^\s].*?\.exe)\s+pid:\s+(?<pid>\d+)') {
            $currentOwner = $Matches['owner']
            $currentOwnerPid = $Matches['pid']
            continue
        } elseif ($currentOwner -and $line -match 'RobloxPlayerBeta\.exe' -and $line -match '(?i)process') {
            $ownerName = $currentOwner
            $ownerPid = $currentOwnerPid
        }

        if (-not $ownerName) { continue }

        $ownerBase = [System.IO.Path]::GetFileNameWithoutExtension($ownerName)
        $isAllowed = $false
        foreach ($safe in $RobloxHandleOwnerAllowlist) {
            if ($ownerBase -ieq $safe) { $isAllowed = $true; break }
        }

        if (-not $isAllowed) {
            $ownerPath = "(path unavailable -- process may have exited or is protected)"
            try {
                $ownerProc = Get-Process -Id $ownerPid -ErrorAction Stop
                if ($ownerProc.Path) { $ownerPath = $ownerProc.Path }
            } catch {
                try {
                    $cimMatch = Get-CimInstance Win32_Process -Filter "ProcessId = $ownerPid" -ErrorAction Stop
                    if ($cimMatch -and $cimMatch.ExecutablePath) { $ownerPath = $cimMatch.ExecutablePath }
                } catch {}
            }
            Write-MonitorLog "FLAGGED (external process holds a handle directly to Roblox's process object -- external memory read/write pattern): $ownerName (PID $ownerPid) path='$ownerPath'" Red
        }
    }
}

