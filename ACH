function Wait-ForEnter {
    param([string]$Message = "Press Enter to continue...")
    Start-Sleep -Seconds 1
    Write-Host $Message -ForegroundColor Yellow
    while ($true) {
        if ([System.Console]::KeyAvailable) {
            $key = [System.Console]::ReadKey($true)
            if ($key.Key -eq "Enter") { break }
        }
        Start-Sleep -Milliseconds 100
    }
}

function Show-LoadingBar {
    param([string]$Label = "Progress")
    for ($i = 0; $i -le 10; $i++) {
        $percent = $i * 10
        $bar = ("#" * $i).PadRight(10, "-")
        Write-Host -NoNewline "`r$Label`: [ $bar ] $percent% " -ForegroundColor White
        Start-Sleep -Milliseconds 200
    }
    Write-Host ""
    Write-Host ""
}

function Write-Section {
    param([string]$Title, [string[]]$Lines)
    Write-Host "--- $Title ---" -ForegroundColor White
    foreach ($line in $Lines) {
        if ($line -match "^SUCCESS") { Write-Host $line -ForegroundColor Green }
        elseif ($line -match "^FAILURE") { Write-Host $line -ForegroundColor Red }
        elseif ($line -match "^WARNING") { Write-Host $line -ForegroundColor Yellow }
        elseif ($line -match "^INFO") { Write-Host $line -ForegroundColor Cyan }
        else { Write-Host $line -ForegroundColor White }
    }
    Write-Host ""
}

function Save-RemoteFile {
    param(
        [Parameter(Mandatory = $true)][string]$Uri,
        [Parameter(Mandatory = $true)][string]$Path,
        # Every caller of this used to inherit whatever the default .NET
        # connect/read timeout happens to be, which on a flaky or
        # DNS-filtered network (school/dorm wifi, some AV/firewalls block
        # pastebin.com specifically) can sit for a long time before finally
        # giving up. That's fine when it's a one-off step, but this same
        # helper backs Get-ForensicTool -- and one of those tools
        # (Test-KernelDrivers' known-driver list) gets re-fetched every 60s
        # for the whole match, INSIDE the monitoring loop, blocking the
        # Enter-key check until it returns. Bounding it here means a bad
        # network costs at most ~2x this many seconds, not minutes.
        [int]$TimeoutSec = 10
    )
    $parent = Split-Path -Parent $Path
    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
        New-Item -ItemType Directory -Path $parent -Force | Out-Null
    }

    try {
        # Resolve the cmdlet by its module-qualified name so a tampered profile
        # alias can't quietly redirect this download.
        $webRequestCmd = Get-Command -Name Invoke-WebRequest -CommandType Cmdlet -ErrorAction Stop
        & "$($webRequestCmd.Source)\Invoke-WebRequest" -Uri $Uri -OutFile $Path -UseBasicParsing -TimeoutSec $TimeoutSec -ErrorAction Stop
        return
    } catch {
        $client = $null
        try {
            $client = New-Object System.Net.WebClient
            $downloadTask = $client.DownloadFileTaskAsync($Uri, $Path)
            if (-not $downloadTask.Wait([TimeSpan]::FromSeconds($TimeoutSec))) {
                throw "timed out after ${TimeoutSec}s (network unreachable or DNS blocked '$([Uri]::new($Uri).Host)')"
            }
            if ($downloadTask.IsFaulted) {
                throw $downloadTask.Exception.InnerException
            }
        } catch {
            throw "Could not download $Uri to $Path. $($_.Exception.Message)"
        } finally {
            if ($client) { $client.Dispose() }
        }
    }
}

# Persistent tool cache so re-runs don't re-download Autoruns/WinObj/Process
# Explorer/PECmd/AmcacheParser every single time.
$PersistentToolsRoot = "C:\ToolsACH"
