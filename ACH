# Hash-chain the log so a reviewer can tell if a line was edited or removed
# after the fact: each line's chain hash covers the previous chain hash plus
# that line's own text, so altering any earlier line breaks every hash after
# it. This is tamper-evidence, not encryption -- it won't stop someone from
# editing the file, but it will make the edit detectable.
function Get-ChainHash {
    param([string]$PreviousHash, [string]$Line)
    $sha256 = [System.Security.Cryptography.SHA256]::Create()
    $bytes = [System.Text.Encoding]::UTF8.GetBytes("$PreviousHash|$Line")
    return ([BitConverter]::ToString($sha256.ComputeHash($bytes))).Replace("-", "")
}
$Global:LogChainHash = Get-ChainHash -PreviousHash "GENESIS" -Line $firstLine
Add-Content -LiteralPath $monitorLogPath -Value "[chain:$Global:LogChainHash]"

